# syntax=docker/dockerfile:1

# Minimal Workspace runtime image for the Kind e2e suite. It holds only a POSIX
# shell and the agent user. It has no rc-kube and no tini: the controller
# injects both from the rc-kube image, and rc-kube serve re-executes itself
# under the injected tini when it runs as PID 1. The controller runs the
# runtime as UID/GID 1000, mounts the home volume at /home/agent and an
# emptyDir at /run/rc, and execs "/opt/rc/bin/rc-kube process ..." for
# activity, history, and WorkspaceExec. The full Dockerfile.runner adds the
# developer toolchains, which the e2e suite does not use.
FROM alpine:3.23

RUN addgroup -g 1000 agent \
    && adduser -D -u 1000 -G agent -h /home/agent -s /bin/sh agent \
    && install -d -m 0755 -o 1000 -g 1000 /workspace

ENV SHELL="/bin/sh"

USER 1000:1000
WORKDIR /workspace
