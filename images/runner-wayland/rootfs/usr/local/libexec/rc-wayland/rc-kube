#!/bin/sh
set -eu

args_file=/run/rc/rc-kube-serve.args
if ! test -f "${args_file}"; then
  echo "rc-kube serve argument file does not exist" >&2
  exit 2
fi

set -- serve
while IFS= read -r arg; do
  set -- "$@" "${arg}"
done < "${args_file}"

# The init program records the rc-kube that the controller injected. A
# runtime started without it runs the rc-kube of this image.
executable=/usr/local/libexec/rc-kube
executable_file=/run/rc/rc-kube-serve.executable
if test -f "${executable_file}"; then
  IFS= read -r executable < "${executable_file}"
fi

exec "${executable}" "$@"
