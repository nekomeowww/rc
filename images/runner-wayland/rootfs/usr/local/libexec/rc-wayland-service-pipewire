#!/bin/sh
set -eu

pipewire &
pid=$!
trap 'kill -TERM "$pid" 2>/dev/null || true' TERM INT EXIT

for _ in $(seq 1 100); do
  if test -S "${XDG_RUNTIME_DIR}/pipewire-0"; then
    printf '\n' >&3
    wait "$pid"
    exit $?
  fi
  kill -0 "$pid" 2>/dev/null || wait "$pid"
  sleep 0.1
done

echo "PipeWire socket did not become ready" >&2
exit 1
