#!/bin/sh
set -eu

wireplumber &
pid=$!
trap 'kill -TERM "$pid" 2>/dev/null || true' TERM INT EXIT

for _ in $(seq 1 100); do
  if wpctl status >/dev/null 2>&1; then
    printf '\n' >&3
    wait "$pid"
    exit $?
  fi
  kill -0 "$pid" 2>/dev/null || wait "$pid"
  sleep 0.1
done

echo "WirePlumber did not become ready" >&2
exit 1
