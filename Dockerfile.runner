# syntax=docker/dockerfile:1

# Build rcctl and rc-kube for Workspace runtime Pods and Repository/Worktree Jobs.
FROM --platform=$BUILDPLATFORM golang:1.27.1 AS builder

ARG TARGETOS
ARG TARGETARCH

WORKDIR /workspace
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} \
        go build -trimpath -o /out/rcctl ./cmd/rcctl \
    && CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} \
        go build -trimpath -o /out/rc-kube ./cmd/rc-kube

FROM --platform=$BUILDPLATFORM debian:bookworm-slim AS tool-downloader

ARG TARGETARCH
ARG MISE_VERSION=2026.9.7
ARG MISE_SHA256_AMD64=011e71834ef919c775f8d8ba7a985295a39a3ffe322b5f87a61cc0293eb6567f
ARG MISE_SHA256_ARM64=3c43ee044bb7d8bdaea800e1796a0b5d983276384f81d477c059a2b910042e16
ARG PROTO_VERSION=0.62.2
ARG PROTO_SHA256_AMD64=d240e8c502ae8fdd72aad67348e4481211fa84c7cbb1a6c667993bd02b140c0b
ARG PROTO_SHA256_ARM64=f4b5b38c1ad47de155e93c4c728fb09ae39f44b650bf04bd825887cbfc638545

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl xz-utils \
    && rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    case "${TARGETARCH}" in \
        amd64) \
            mise_arch=x64; \
            mise_sha256="${MISE_SHA256_AMD64}"; \
            proto_target=x86_64-unknown-linux-gnu; \
            proto_sha256="${PROTO_SHA256_AMD64}" \
            ;; \
        arm64) \
            mise_arch=arm64; \
            mise_sha256="${MISE_SHA256_ARM64}"; \
            proto_target=aarch64-unknown-linux-gnu; \
            proto_sha256="${PROTO_SHA256_ARM64}" \
            ;; \
        *) \
            echo "Unsupported target architecture: ${TARGETARCH}" >&2; \
            exit 1 \
            ;; \
    esac; \
    curl -fsSLo /tmp/mise.tar.xz \
        "https://github.com/jdx/mise/releases/download/v${MISE_VERSION}/mise-v${MISE_VERSION}-linux-${mise_arch}.tar.xz"; \
    echo "${mise_sha256}  /tmp/mise.tar.xz" | sha256sum --check --strict; \
    mkdir -p /tmp/mise; \
    tar -xJf /tmp/mise.tar.xz -C /tmp/mise --strip-components=2 mise/bin/mise; \
    install -Dm755 /tmp/mise/mise /out/mise; \
    curl -fsSLo /tmp/proto.tar.xz \
        "https://github.com/moonrepo/proto/releases/download/v${PROTO_VERSION}/proto_cli-${proto_target}.tar.xz"; \
    echo "${proto_sha256}  /tmp/proto.tar.xz" | sha256sum --check --strict; \
    mkdir -p /tmp/proto; \
    tar -xJf /tmp/proto.tar.xz -C /tmp/proto --strip-components=1; \
    install -Dm755 /tmp/proto/proto /out/proto; \
    install -Dm755 /tmp/proto/proto-shim /out/proto-shim

FROM node:26.8.2-bookworm-slim AS runner

ARG COREPACK_VERSION=0.36.0
ARG LOBEHUB_CLI_VERSION=0.0.54

LABEL org.opencontainers.image.source="https://github.com/nekomeowww/rc" \
    org.opencontainers.image.title="rc runner"

# Preinstall Playwright Chromium dependencies because Workspace processes
# cannot elevate privileges to install system packages at runtime.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        btop \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        fonts-freefont-ttf \
        fonts-ipafont-gothic \
        fonts-liberation \
        fonts-noto-color-emoji \
        fonts-tlwg-loma-otf \
        fonts-unifont \
        fonts-wqy-zenhei \
        gh \
        git \
        git-lfs \
        gzip \
        htop \
        libasound2 \
        libatk-bridge2.0-0 \
        libatk1.0-0 \
        libatomic1 \
        libatspi2.0-0 \
        libcairo2 \
        libcups2 \
        libdbus-1-3 \
        libdrm2 \
        libfontconfig1 \
        libfreetype6 \
        libgbm1 \
        libglib2.0-0 \
        libnspr4 \
        libnss3 \
        libpango-1.0-0 \
        libx11-6 \
        libxcb1 \
        libxcomposite1 \
        libxdamage1 \
        libxext6 \
        libxfixes3 \
        libxkbcommon0 \
        libxrandr2 \
        openssh-client \
        pkg-config \
        procps \
        python3 \
        ripgrep \
        sudo \
        tar \
        unzip \
        wget \
        xfonts-scalable \
        xvfb \
        xz-utils \
        zip \
    && npm install --global --ignore-scripts \
        "corepack@${COREPACK_VERSION}" \
        "@lobehub/cli@${LOBEHUB_CLI_VERSION}" \
    && test "$(lh --version)" = "${LOBEHUB_CLI_VERSION}" \
    && test "$(lobe --version)" = "${LOBEHUB_CLI_VERSION}" \
    && test "$(lobehub --version)" = "${LOBEHUB_CLI_VERSION}" \
    && rm -rf /tmp/lobehub \
    && npm cache clean --force \
    && gh --version \
    && rm -rf /var/lib/apt/lists/* \
    && usermod --login agent --home /home/agent --move-home --shell /bin/bash node \
    && groupmod --new-name agent node \
    && groupadd --gid 65532 rc \
    && useradd --uid 65532 --gid 65532 --create-home --shell /bin/bash rc \
    && git config --system --add safe.directory '*'

COPY --from=builder /out/rcctl /usr/local/bin/rcctl
COPY --from=builder /out/rc-kube /usr/local/bin/rc-kube
COPY --from=tool-downloader /out/mise /usr/local/bin/mise
COPY --from=tool-downloader /out/proto /usr/local/bin/proto
COPY --from=tool-downloader /out/proto-shim /usr/local/bin/proto-shim

# Keep rebuildable tool metadata on container-local storage, not the home PVC.
# This directory is not a persistent volume and may disappear on runtime replacement.
RUN install -d -m 0700 -o 1000 -g 1000 /tmp/cache

ENV SHELL="/bin/bash" \
    XDG_CACHE_HOME="/tmp/cache"

USER 1000:1000
RUN test -w /tmp/cache
WORKDIR /workspace

ENTRYPOINT ["rc-kube"]
